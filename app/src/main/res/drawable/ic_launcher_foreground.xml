    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 整体略向左上偏移，使视觉重心落在自适应图标的安全区中心 -->
    <group
        android:translateX="-1.5"
        android:translateY="-2">

        <!-- 左后方：玻璃杯，仅描边，保留通透感 -->
        <path
            android:pathData="M29.7,36.3 L47.3,36.3 L44.9,66.4 Q44.9,69 42,69 L35,69 Q32.1,69 32.1,66.4 Z"
            android:strokeColor="#2E7D6B"
            android:strokeWidth="2.8"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />

        <!-- 杯中的半杯水 -->
        <path
            android:pathData="M32.6,52.8 L44.4,52.8 L43.3,66 Q43.3,67.4 41.5,67.4 L35.5,67.4 Q33.7,67.4 33.7,66 Z"
            android:fillColor="#6FBFAE" />

        <!-- 右前方：空碟子（外沿 + 内圈，形成浅浅的盘面） -->
        <path
            android:pathData="M50.5,71 a15.5,5.6 0 1,0 31,0 a15.5,5.6 0 1,0 -31,0 Z"
            android:fillColor="#F1F8F6"
            android:strokeColor="#2E7D6B"
            android:strokeWidth="2.4"
            android:strokeLineJoin="round" />

        <path
            android:pathData="M54.4,71 a11.6,3.9 0 1,0 23.2,0 a11.6,3.9 0 1,0 -23.2,0 Z"
            android:strokeColor="#7FBFAF"
            android:strokeWidth="1.3" />
    </group>
</vector>
